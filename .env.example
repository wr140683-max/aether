XAI_API_KEY=

# Alternatives
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional cloud sandbox
E2B_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
